# Copia aquest fitxer a .env i omple els valors. MAI pugis .env al repositori.
# A GitHub Actions aquests valors van a Settings → Secrets and variables → Actions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Google AI Studio → Get API key
GEMINI_API_KEY=
# Alternativa quan s'esgota la quota de Gemini (opcional)
GROQ_API_KEY=
# Eventbrite → Account Settings → Developer Links → API Keys → Private token (opcional)
EVENTBRITE_TOKEN=
# Instagram (API de Meta, Business Discovery): ho omple python -m event_pipeline.manage instagram-setup
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=
