# Copia aquest fitxer a .env.local i omple els valors. MAI pugis .env.local al repositori.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Només al servidor (Route Handlers del bot, Share Target). No la prefixis amb NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Google AI Studio → Get API key (Fase 2: processament immediat del bot i del Share Target)
GEMINI_API_KEY=
# Botó «Actualitzar ara» (Configuració → Fonts). GitHub → Settings → Developer settings → Fine-grained tokens:
# només el repositori event-selector, permís «Actions: Read and write». Només al servidor (sense NEXT_PUBLIC_).
GITHUB_DISPATCH_TOKEN=
